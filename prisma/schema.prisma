generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  EDITOR
}

enum OrderStatus {
  PENDING
  PURCHASED
  RECEIVED_PARIS
  SHIPPED_DESTINATION
  ARRIVED_DESTINATION
  DELIVERED
  CANCELLED
}

enum PricingType {
  PER_KG
  PERCENTAGE
  FIXED
}

enum MessageStatus {
  UNREAD
  READ
}

model AdminUser {
  id                  String    @id @default(cuid())
  email               String    @unique @db.VarChar(254)
  password            String    @db.VarChar(100)
  name                String    @db.VarChar(100)
  role                Role      @default(ADMIN)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@map("admin_users")
}

model Store {
  id           String   @id @default(cuid())
  name         String   @db.VarChar(100)
  slug         String   @unique @db.VarChar(100)
  logo         String?  @db.LongText
  websiteUrl   String   @db.VarChar(2048)
  category     String   @db.VarChar(80)
  description  String?  @db.Text
  isActive     Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("stores")
}

model ExchangeRate {
  id           String   @id @default(cuid())
  name         String   @db.VarChar(150)
  rate         Float
  currencyFrom String   @default("EUR") @db.VarChar(10)
  currencyTo   String   @default("XOF") @db.VarChar(10)
  description  String?  @db.Text
  isActive     Boolean  @default(true)
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  @@map("exchange_rates")
}

model ShippingRate {
  id                String      @id @default(cuid())
  name              String      @db.VarChar(100)
  pricingType       PricingType
  price             Float?
  percentage        Float?
  description       String?     @db.Text
  estimatedDelivery String?     @db.VarChar(100)
  isActive          Boolean     @default(true)
  displayOrder      Int         @default(0)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@map("shipping_rates")
}

model Order {
  id                 String          @id @default(cuid())
  trackingNumber     String          @unique @db.VarChar(100)
  customerName       String          @db.VarChar(100)
  customerPhone      String          @db.VarChar(30)
  customerEmail      String?         @db.VarChar(254)
  storeName          String?         @db.VarChar(100)
  storeOrderNumber   String?         @db.VarChar(100)
  amount             Float?
  packageCount       Int?
  weight             Float?
  weightAddedAt      DateTime?
  destinationCity    String          @db.VarChar(100)
  destinationCountry String          @db.VarChar(100)
  internalNotes      String?         @db.Text
  status             OrderStatus     @default(PENDING)
  orderDate          DateTime        @default(now())
  trackingEvents     TrackingEvent[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([weightAddedAt])
  @@map("orders")
}

model Client {
  id        String   @id @default(cuid())
  name      String   @db.VarChar(150)
  phone     String   @unique @db.VarChar(30)
  email     String?  @db.VarChar(254)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("clients")
}

model TrackingEvent {
  id           String      @id @default(cuid())
  orderId      String
  order        Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status       OrderStatus
  title        String      @db.VarChar(150)
  description  String?     @db.Text
  location     String?     @db.VarChar(150)
  eventDate    DateTime
  displayOrder Int         @default(0)
  createdAt    DateTime    @default(now())

  @@map("tracking_events")
}

model Testimonial {
  id           String   @id @default(cuid())
  name         String   @db.VarChar(100)
  photo        String?  @db.VarChar(2048)
  rating       Int      @default(5)
  comment      String   @db.Text
  isPublished  Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("testimonials")
}

model FAQ {
  id           String   @id @default(cuid())
  question     String   @db.VarChar(300)
  answer       String   @db.Text
  isPublished  Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("faqs")
}

model ContactMessage {
  id        String        @id @default(cuid())
  name      String        @db.VarChar(100)
  phone     String        @db.VarChar(30)
  email     String?       @db.VarChar(254)
  subject   String        @db.VarChar(150)
  message   String        @db.Text
  status    MessageStatus @default(UNREAD)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@map("contact_messages")
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique @db.VarChar(100)
  value     String   @db.LongText
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@map("site_settings")
}

model PublicRateLimit {
  key       String   @id @db.VarChar(191)
  attempts  Int      @default(1)
  expiresAt DateTime
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
  @@map("public_rate_limits")
}
